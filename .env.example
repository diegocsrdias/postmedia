# ============================================================
# BACKEND (Vercel Functions) — chave da OpenAI fica SÓ no servidor.
# No Vercel, defina estas em: Project → Settings → Environment Variables.
# Localmente, o `vercel dev` lê este arquivo (copie para .env).
# ============================================================

# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelo de TEXTO (headline/legenda/hashtags). Recomendado: gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# Modelo de IMAGEM (fundo por IA). Recomendado: gpt-image-1
OPENAI_IMAGE_MODEL=gpt-image-1

# ============================================================
# FRONT-END (opcional) — só se a API estiver em outra origem.
# Em produção no Vercel (mesmo projeto), deixe em branco: usa /api.
# ============================================================
# VITE_API_BASE=/api
