# ============================================================
# BACKEND (Vercel Functions) — chave da OpenAI fica SÓ no servidor.
# No Vercel, defina estas em: Project → Settings → Environment Variables.
# Localmente, o `vercel dev` lê este arquivo (copie para .env).
# ============================================================

# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelo de TEXTO (headline/legenda/hashtags). Recomendado: gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# Modelo de IMAGEM (fundo por IA). Recomendado: gpt-image-1
OPENAI_IMAGE_MODEL=gpt-image-1

# ============================================================
# INSTAGRAM (botão "Postar no Instagram") — publica no feed via Graph API.
# Requer conta Business vinculada a uma Página do Facebook e um app na
# Meta for Developers. Ver README → "Postar no Instagram".
# ============================================================

# ID da conta Instagram Business (número). Ex.: 178414...
# Este par (sem sufixo) é a conta do cliente PADRÃO (IG_DEFAULT_CLIENT, = dindin).
IG_USER_ID=

# Token de acesso de LONGA duração (60 dias). NUNCA versione este valor.
IG_ACCESS_TOKEN=

# --- Múltiplos clientes -------------------------------------------------------
# Cada cliente adicional tem seu próprio par, com o id do cliente em MAIÚSCULAS
# como sufixo (mesmos ids de src/clients/*). Ex.: para a Rachel:
#   IG_USER_ID_RACHEL=17841...      (IG_USER_ID numérico da conta dela)
#   IG_ACCESS_TOKEN_RACHEL=...      (token de longa duração da conta dela)
# Sem o par próprio, um cliente não-padrão NÃO publica (erro explícito) — nunca
# cai no perfil padrão por engano. Opcional: trocar o cliente padrão com
#   IG_DEFAULT_CLIENT=dindin

# Host da Graph API. Deixe em branco para o padrão (login do Facebook).
# Se usar "login do Instagram", troque para https://graph.instagram.com/v21.0
# IG_GRAPH_BASE=https://graph.facebook.com/v21.0

# ============================================================
# SUPABASE — bucket das mídias + banco de posts (base do aprendizado).
# Dashboard do Supabase → Project Settings → API.
# ============================================================

# URL do projeto (ex.: https://xxxxx.supabase.co) — não é secreto.
SUPABASE_URL=

# SERVICE ROLE KEY (secreta!). Ignora RLS — NUNCA vai ao navegador nem ao Git.
SUPABASE_SERVICE_ROLE_KEY=

# Nome do bucket de mídias (padrão: creatives).
# SUPABASE_BUCKET=creatives

# ============================================================
# AGENDADOR AUTOPILOT — gera + renderiza (Chromium headless) + posta sozinho.
# ============================================================

# URL pública do próprio deploy, onde a rota /render.html é servida. O runner
# (api/run-scheduler) abre essa URL no Chromium para fotografar a arte. No Vercel
# a VERCEL_URL já é usada como fallback, mas defina PUBLIC_BASE_URL com o domínio
# final (ex.: https://postmedia.vercel.app) para evitar URLs de preview.
PUBLIC_BASE_URL=

# Segredo que protege os endpoints de cron (ig-sync-insights, build-learnings,
# run-scheduler). O Vercel envia "Authorization: Bearer <CRON_SECRET>" nos crons.
# Para disparo manual, mande esse header (ou ?key=<CRON_SECRET>). Se vazio, os
# crons ficam abertos (defina em produção!).
CRON_SECRET=

# ============================================================
# FRONT-END (opcional) — só se a API estiver em outra origem.
# Em produção no Vercel (mesmo projeto), deixe em branco: usa /api.
# ============================================================
# VITE_API_BASE=/api
