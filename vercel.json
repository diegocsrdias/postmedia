{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/run-scheduler.js": {
      "maxDuration": 300,
      "memory": 2048
    },
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/ig-sync-insights",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/build-learnings",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/run-scheduler",
      "schedule": "0 * * * *"
    }
  ]
}
